{
	"name": "shopifylabs",
	"version": "0.0.0",
	"private": true,
	"description": "A modular TypeScript toolkit for Shopify theme development",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"clean": "turbo run clean",
		"typecheck": "turbo run typecheck",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "turbo run build && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@changesets/cli": "^2.31.0",
		"@vitest/coverage-v8": "^4.1.6",
		"jsdom": "^29.1.1",
		"turbo": "^2.5.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.6"
	},
	"packageManager": "pnpm@9.15.4",
	"engines": {
		"node": ">=20.0.0"
	}
}
