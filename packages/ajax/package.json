{
  "name": "@shopifylabs/ajax",
  "version": "0.1.0",
  "description": "Shopify AJAX API wrapper with typed responses",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["shopify", "ajax", "cart", "fetch", "api", "shopifylabs"],
  "author": "ShopifyLabs",
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "rimraf": "^6.0.1"
  },
  "sideEffects": false,
  "license": "MIT"
}
